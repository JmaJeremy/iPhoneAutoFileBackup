<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>iPhoneVideoBackup</RootNamespace>
    <AssemblyName>iPhoneVideoBackup</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MediaDevices" Version="1.10.0" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>

  <!-- Optional InpOut DLLs for PC speaker beeps: copied to the output when placed next to this file -->
  <ItemGroup>
    <None Include="inpoutx64.dll" Condition="Exists('inpoutx64.dll')" CopyToOutputDirectory="PreserveNewest" />
    <None Include="inpout32.dll" Condition="Exists('inpout32.dll')" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
